  "qualityGate": {
    "json": {
      "metadata": "jq empty .github/github.json runtime/bindings.example.json runtime/game-profile.schema.json runtime/manifest.json runtime/manifest.lock.json runtime/profiles/*.json runtime/experiments/*.json"
    },
    "lint": {
      "markdown": "npx --yes markdownlint-cli2 \"README.md\" \"AGENTS.md\" \"docs/*.md\" \"docs/**/*.md\" \"patches/**/*.md\"",
      "workflows": "actionlint -config-file .github/actionlint.yaml .github/workflows/ci.yml .github/workflows/codeql.yml",
      "pythonTools": "python3 -m py_compile tools/vr_stack_cleanup.py tools/vr_stack_cleanup_test.py tools/launch_freedom_crossover.py tools/build_macos_ui_helper.py tools/macos_ui_helper_client.py tools/macos_ui_helper_client_test.py tools/build_runtime_artifact.py tools/runtime_profile.py tools/runtime_profile_test.py tools/runtime_control.py tools/macos_consent_matrix.py tools/macos_consent_matrix_test.py tools/runtime_cli.py tools/runtime_start.py tools/runtime_control_test.py tools/runtime_start_test.py tools/runtime_descriptor.py tools/runtime_descriptor_test.py tools/runtime_transaction.py tools/runtime_transaction_test.py tools/runtime_install.py tools/runtime_install_test.py",
      "shellTools": "bash -n tools/run_real_openvr_iosurface_probe.sh tools/run_real_native_iosurface_probe.sh tools/run_freedom_local_window_regression.sh tools/run_open_brush_runtime_discovery.sh tools/run_open_brush_native_probe.sh tools/run_steamvr_tutorial_unity_control.sh tools/run_iosurface_mach_port_probe.sh tools/run_wine_iosurface_mach_port_probe.sh tools/run_dxvk_native_iosurface_bind_probe.sh && shellcheck tools/run_real_openvr_iosurface_probe.sh tools/run_real_native_iosurface_probe.sh tools/run_freedom_local_window_regression.sh tools/run_open_brush_runtime_discovery.sh tools/run_open_brush_native_probe.sh tools/run_steamvr_tutorial_unity_control.sh tools/run_iosurface_mach_port_probe.sh tools/run_wine_iosurface_mach_port_probe.sh tools/run_dxvk_native_iosurface_bind_probe.sh"
    },
    "security": {
      "secretScan": "gitleaks detect --source . --no-git --redact --verbose",
      "gitleaksVersion": "8.30.1"
    },
    "ciScope": {
      "docsOnlyPullRequests": "Pull requests whose changes are limited to Markdown, docs/, LICENSE, or .github/github.json run hygiene, JSON, lint, secret scan, and the profile/artifact contract checks, and skip the Python fixture suites and the macOS lifecycle lane. Pushes to main run everything.",
      "laneBudgetSeconds": 300,
      "laneBudget": "Each CI lane writes its elapsed time to the job summary and emits a warning when it exceeds the budget; it does not fail the lane."
    },
    "macosUiHelper": {
      "contract": "python3 tools/build_macos_ui_helper.py check",
      "unit": "swift test --package-path tools/macos_ui_helper",
      "clientFixtures": "python3 tools/macos_ui_helper_client_test.py"
    },
    "runtimeArtifact": {
      "contract": "python3 tools/build_runtime_artifact.py check",
      "fixtures": "python3 tools/build_runtime_artifact.py self-test"
    },
    "runtimeProfile": {
      "check": "python3 tools/runtime_profile.py check",
      "experimentCheck": "python3 tools/runtime_profile.py check runtime/experiments/*.json",
      "fixtures": "python3 tools/runtime_profile.py self-test",
      "admissionFixtures": "python3 tools/runtime_profile_test.py"
    },
    "runtimeControl": {
      "fixtures": "python3 tools/runtime_control_test.py",
      "startFixtures": "python3 tools/runtime_start_test.py",
      "help": "python3 tools/runtime_cli.py --help"
    },
    "macosConsentMatrix": {
      "fixtures": "python3 tools/macos_consent_matrix_test.py",
      "compile": "python3 -m py_compile tools/macos_consent_matrix.py tools/macos_consent_matrix_test.py"
    },
    "runtimeTransaction": {
      "fixtures": "python3 tools/runtime_transaction_test.py",
      "compile": "python3 -m py_compile tools/runtime_descriptor.py tools/runtime_transaction.py tools/runtime_transaction_test.py"
    },
    "runtimeDescriptor": {
      "fixtures": "python3 tools/runtime_descriptor_test.py",
      "compile": "python3 -m py_compile tools/runtime_descriptor.py tools/runtime_descriptor_test.py",
      "linux": "RUNTIME_FIXTURE_ROOT=/tmp/runtime-fixtures python3 tools/runtime_descriptor_test.py"
    },
    "runtimeLifecycle": {
      "fixtures": "python3 tools/runtime_install_test.py",
      "compile": "python3 -m py_compile tools/runtime_descriptor.py tools/runtime_install.py tools/runtime_cli.py tools/runtime_install_test.py"
    },
    "runtimePreflight": {
      "vrStackCleanupFixtures": "python3 tools/vr_stack_cleanup_test.py"
    },
    "docsRequiredWhen": [
      "new experiment plans are added",
      "validation gates change",
      "primary commands change",
      "hardware/runtime assumptions change",
      "cleanup policy changes",
      "GitHub workflow changes",
      "dependency automation changes"
    ]
  },
  "importantWorkflows": [
    "CI",
    "CodeQL",
    "Dependabot Updates"
  ],
  "requiredStatusChecks": [
    "Repo Hygiene"
  ],
  "qaLabels": [],
  "deployLabels": [],
  "healthUrls": [],
  "relatedRepos": [
    {
      "name": "alvr-visionos",
      "repo": "cbusillo/alvr-visionos",
      "localPath": "../alvr-visionos",
      "purpose": "Apple Vision Pro client source; runtime source pins are in runtime/manifest.json."
    },
    {
      "name": "ALVR",
      "repo": "cbusillo/ALVR",
      "localPath": "../alvr",
      "purpose": "macOS bridge host source; runtime source pins are in runtime/manifest.json."
    }
  ],
  "githubSignals": {
    "postMerge": {
      "waitForActions": true,
      "checkSecurityAndQuality": true
    },
    "capabilities": {
      "codeScanning": "available",
      "secretScanning": "available",
      "dependabotAlerts": "available",
      "securityAdvisories": "available"
    },
    "refreshWhen": [
      "repo visibility changes",
      "GitHub plan changes",
      "security settings change",
      "token permissions change"
    ]
  },
  "cleanup": {
    "deleteMergedLocalBranches": true,
    "removeMergedCleanWorktrees": true
  },
  "metadataFreshness": {
    "updateWhen": [
      "docs routing changes",
      "validation gates change",
      "primary commands change",
      "important workflows change",
      "repo relationship changes",
      "cleanup policy changes",
      "hardware/runtime assumptions change",
      "GitHub workflow changes",
      "dependency automation changes"
    ]
  }
}
